# Physical phone + Expo Go: use your Mac LAN IP (NOT localhost — localhost is the phone).
# Example: http://192.168.1.21:8000/api/v1
#
# ngrok: run `php artisan serve --host=0.0.0.0 --port=8000` and `ngrok http 8000`,
# then paste the https URL here. Restart `npm start` after any .env change.
EXPO_PUBLIC_API_URL=http://192.168.1.21:8000/api/v1
