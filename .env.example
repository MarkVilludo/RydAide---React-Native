# Deployed API (same Laravel as https://rydaid.quantumrealm.tech/admin/login)
EXPO_PUBLIC_API_URL=https://rydaid.quantumrealm.tech/api/v1

# Local Mac API only — comment the line above and use:
# EXPO_PUBLIC_API_ENV=local
# EXPO_PUBLIC_API_URL=http://192.168.1.8:8000/api/v1

# Maps (optional)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# EAS (from expo.dev → project settings)
# Optional override (default in app.config.js): 579d9891-5bb8-4e2b-b4f0-975570d3d60e
# EXPO_PUBLIC_EAS_PROJECT_ID=

# In-app subscription SKU — must match App Store Connect + Play Console + Laravel .env
EXPO_PUBLIC_MECHANIC_PRO_PRODUCT_ID=com.rydaid.mechanic.pro.monthly
# Optional yearly SKU — must match store consoles + Laravel APP_STORE_/GOOGLE_PLAY_*_YEARLY_PRODUCT_ID
# EXPO_PUBLIC_MECHANIC_PRO_YEARLY_PRODUCT_ID=com.rydaid.mechanic.pro.yearly

# Must match native app IDs (also set in app.config.js / eas.json base env)
EXPO_PUBLIC_IOS_BUNDLE_ID=com.rydaid.mobile
EXPO_PUBLIC_ANDROID_PACKAGE=com.rydaid.mobile

# Sandbox: set true for development / preview / testflight EAS profiles (default in eas.json).
# Set false for production store builds.
EXPO_PUBLIC_STORE_SANDBOX=true
