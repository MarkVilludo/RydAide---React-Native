# --- API (same Laravel as /admin/login on production) ---
#
# Option A — local dev on a physical device (recommended in .env):
# Get Mac IP: ipconfig getifaddr en0  then: php artisan serve --host=0.0.0.0 --port=8000
EXPO_PUBLIC_API_URL=http://192.168.1.8:8000/api/v1
#
# Option B — point dev build at live site (comment out EXPO_PUBLIC_API_URL and use):
# EXPO_PUBLIC_API_ENV=production
#
# Option C — EAS store/internal builds: no .env needed; release builds auto-use production.
# Set once in eas.json (see EXPO_PUBLIC_PRODUCTION_API_URL).
#
# EXPO_PUBLIC_PRODUCTION_API_URL=https://rydaid.quantumrealm.tech/api/v1

# Maps (optional)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# EAS (from expo.dev → project settings)
# EXPO_PUBLIC_EAS_PROJECT_ID=

# In-app subscription SKU — must match App Store Connect + Play Console + Laravel .env
EXPO_PUBLIC_MECHANIC_PRO_PRODUCT_ID=com.rydaid.mechanic.pro.monthly

# Must match native app IDs (also set in app.config.js / eas.json base env)
EXPO_PUBLIC_IOS_BUNDLE_ID=com.rydaid.mobile
EXPO_PUBLIC_ANDROID_PACKAGE=com.rydaid.mobile

# Sandbox: set true for development / preview / testflight EAS profiles (default in eas.json).
# Set false for production store builds.
EXPO_PUBLIC_STORE_SANDBOX=true
