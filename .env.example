# Physical phone + Expo Go: use your Mac LAN IP (NOT localhost — localhost is the phone).
#
# Mac IP:  ipconfig getifaddr en0
# API:    php artisan serve --host=0.0.0.0 --port=8000
# Test:   curl http://YOUR_IP:8000/api/v1/app-config
#
# After changing this file, restart Expo with cache clear:  npx expo start -c
EXPO_PUBLIC_API_URL=http://192.168.1.62:8000/api/v1

# Android maps (Google Maps SDK via expo-maps). Required if map is blank on Android.
# Enable ONLY "Maps SDK for Android" — free tier + $0 budget alert. See docs/MAPS.md
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
