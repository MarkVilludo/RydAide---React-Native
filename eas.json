{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_MECHANIC_PRO_PRODUCT_ID": "com.rydaid.mechanic.pro.monthly",
        "EXPO_PUBLIC_IOS_BUNDLE_ID": "com.rydaid.mobile",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.rydaid.mobile",
        "EXPO_PUBLIC_PRODUCTION_API_URL": "https://rydaid.quantumrealm.tech/api/v1"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_STORE_SANDBOX": "true"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_STORE_SANDBOX": "true"
      }
    },
    "testflight": {
      "extends": "base",
      "distribution": "store",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_STORE_SANDBOX": "true"
      }
    },
    "internal-android": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_STORE_SANDBOX": "true",
        "EXPO_PUBLIC_API_URL": "https://rydaid.quantumrealm.tech/api/v1"
      }
    },
    "internal-apk": {
      "extends": "internal-android",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_STORE_SANDBOX": "false",
        "EXPO_PUBLIC_API_URL": "https://rydaid.quantumrealm.tech/api/v1"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      },
      "android": {
        "track": "production"
      }
    },
    "internal-android": {
      "android": {
        "track": "internal"
      }
    }
  }
}
